        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 54,46 L 54,62"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 57,48 L 57,60"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 61,51 L 61,57"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round" />

    <!-- Satellite audio points -->
    <path
        android:pathData="M 54,23 A 2.5,2.5 0 1,0 54,28 A 2.5,2.5 0 1,0 54,23"
        android:fillColor="#FF00E5FF" />
    <path
        android:pathData="M 54,80 A 2.5,2.5 0 1,0 54,85 A 2.5,2.5 0 1,0 54,80"
